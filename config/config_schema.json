{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "External Compositor Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "input", "channels", "processing", "output"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission", "name", "config_type", "schema_version"],
      "properties": {
        "mission": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "config_type": {"type": "string", "enum": ["compositor"]},
        "schema_version": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "band_dimension"],
      "properties": {
        "variable": {"type": "string", "minLength": 1},
        "band_dimension": {"type": "string", "minLength": 1},
        "band_coordinate": {"type": "string", "minLength": 1}
      }
    },
    "channels": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "select"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "select": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "value": {"type": ["string", "number"]}
            }
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip"],
      "properties": {
        "clip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"}
          }
        },
        "nodata_values": {
          "type": "array",
          "items": {"type": "number"},
          "uniqueItems": true
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "preserve_structure",
        "channel_dimension",
        "channel_order",
        "display_range",
        "dtype",
        "fill_value"
      ],
      "properties": {
        "variable": {"type": "string", "minLength": 1},
        "preserve_structure": {"type": "boolean", "const": true},
        "channel_dimension": {"type": "string", "minLength": 1},
        "channel_order": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "display_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"}
          }
        },
        "dtype": {"type": "string", "enum": ["float32", "float64"]},
        "fill_value": {"type": "number"}
      }
    }
  }
}
